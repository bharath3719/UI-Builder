# Environment for the production compose stack. Copy to .env on the server and fill in.
#
#   cp .env.example .env
#
# This is not the file you edit for local development — that one is apps/api/.env, and it
# has its own .env.example with the full annotated list of API variables. This file only
# carries what compose.yaml needs to stand the stack up.

# ── Where it lives ──────────────────────────────────────────────────────────────────

# The domain Caddy answers on, and the name on the certificate it fetches. Point the
# domain's A record at the instance's public IP *before* the first `up`, or the ACME
# challenge fails and Caddy backs off for a while.
#
# For a first smoke test with no domain yet, use `:80` — plain HTTP on the public IP.
# Do not stay there: the session cookie is Secure, so login will not work over HTTP.
SITE_ADDRESS=builder.example.com

# The origin the API accepts credentialed requests from. Same host as SITE_ADDRESS, with
# the scheme — they are separate variables because Caddy wants a hostname and Fastify's
# CORS check wants an origin.
WEB_ORIGIN=https://builder.example.com

# ── Database ────────────────────────────────────────────────────────────────────────
# Postgres runs in the stack and publishes no port to the host, so this password guards
# the compose network rather than the internet. Generate one anyway — `docker compose
# exec` is not the only thing that ends up on a shared VM.
#
#   openssl rand -hex 24
POSTGRES_USER=ui_builder
POSTGRES_PASSWORD=
POSTGRES_DB=ui_builder

# ── Secrets ─────────────────────────────────────────────────────────────────────────

# Signs access tokens. Minimum 32 characters, and the API refuses to boot below that.
#
#   openssl rand -hex 32
JWT_SECRET=

# Encrypts stored API-integration tokens. Optional — derived from JWT_SECRET when empty.
# Set it to 32 bytes as base64 or hex for real key separation, and note that changing it
# later makes already-stored integration tokens undecryptable; the studio asks for them
# again rather than failing quietly.
#
#   openssl rand -base64 32
INTEGRATION_KEY=

# ── Logging ─────────────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Backups ─────────────────────────────────────────────────────────────────────────
# Where deploy/backup.sh copies each nightly dump, so a backup does not share a disk
# with the database it came from. Leave it empty and the dump is written locally only —
# the script says so on every run, because that copy dies with the instance.
#
# Credentials come from the S3_* block below. Prefer a separate bucket from the asset
# one: the asset key lives in a running process, and a backup an attacker can delete is
# not a backup.
#
# BACKUP_S3_DEST=s3://my-backup-bucket/ui-builder

# ── Object storage (uploads) ────────────────────────────────────────────────────────
# Left empty on purpose. With no bucket the API answers 503 on the asset routes and the
# studio does not offer the upload button — the app runs fine, minus image uploads.
#
# To turn uploads on with OCI Object Storage, create a bucket, make it public-read, and
# generate a Customer Secret Key (Identity → your user → Customer Secret Keys). That key
# pair is what goes in ACCESS_KEY_ID / SECRET_ACCESS_KEY — not your OCI API signing key.
# All four of BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY / ENDPOINT must be set together;
# half-configuring it is refused at startup rather than on first upload.
#
# S3_BUCKET=ui-builder-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-mumbai-1
# S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://objectstorage.ap-mumbai-1.oraclecloud.com/n/<namespace>/b/ui-builder-assets/o
