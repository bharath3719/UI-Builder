# Copy to .env and fill in. .env is gitignored; this file is not.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local PostgreSQL install. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# `npm run db:create` creates the database named here if it does not exist yet.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ui_builder?schema=public

# Origin allowed to call this API with credentials (the Vite dev server).
WEB_ORIGIN=http://localhost:5173

# Signs access tokens. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Object storage for uploaded images (S3, or anything speaking its API — R2, MinIO).
#
# Optional, and all-or-nothing: leave the three below empty and the app runs exactly as
# before, minus the upload button, which says why. Fill them in and the image picker in
# the inspector works. Half-filling them is refused at startup rather than on first use.
#
# The bucket must serve these objects publicly: a stored asset URL is written into the
# document and into exported projects, so it has to be fetchable without a signature and
# has to keep working after the link is handed to someone else.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AWS only needs the region. Anything else needs the endpoint too, and most self-hosted
# gateways address buckets by path rather than by subdomain.
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Where browsers read the objects — a CDN, or the bucket's public address. Derived from
# the endpoint and bucket when omitted. Set it when the address you write to and the
# address the world reads from differ, which is the usual case behind a CDN.
# S3_PUBLIC_URL=https://cdn.example.com
