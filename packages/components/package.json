{
  "name": "@ui-builder/components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The built-in component library and its registry. One spec per component feeds the palette, the inspector, the renderer and codegen; '.' is the spec data, './react' the implementations.",
