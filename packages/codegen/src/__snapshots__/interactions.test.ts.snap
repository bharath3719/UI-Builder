// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the interactive project > is this page 1`] = `
"import { useState, type ChangeEvent } from 'react';
import { cell, list, options, pick, text, truthy } from '../lib/values';
import { useQuery } from '../lib/query';
import { useGoTo } from '../lib/navigate';
import { Toasts, useToasts } from '../lib/toast';
import { Overlay } from '../components/Overlay';
import { SortableRows } from '../components/SortableRows';

import styles from './Home.module.css';

export function Home() {
  const [state, setState] = useState<Record<string, any>>({ count: 0, search: '', busy: false });

  const queries = {
    people: useQuery({
      method: 'GET',
      url: \`https://example.com/api/people?q=\${text(state.search)}\`,
      headers: { Accept: 'application/json' },
      runOnLoad: true,
    }),
    save: useQuery({
      method: 'POST',
      url: 'https://example.com/api/visits',
      body: \`{"seen": \${text(state.count)}}\`,
      runOnLoad: false,
    }),
  };

  const [overlays, setOverlays] = useState({ confirmDelete: false });

  const { toasts, showToast } = useToasts();

  const goTo = useGoTo();

  const onSearchChange = (event: ChangeEvent<HTMLInputElement>) => {
    setState((current) => ({ ...current, search: event.target.value }));
  };

  const onCountUpClick = async () => {
    setState((current) => ({ ...current, count: state.count + 1 }));
    setState((current) => ({ ...current, busy: !truthy(current.busy) }));
    await queries.save.run();
    showToast(\`Counted to \${text(state.count + 1)}\`);
  };

  const onDeleteClick = () => {
    setOverlays((current) => ({ ...current, confirmDelete: true }));
  };

  const onConfirmClick = async () => {
    await queries.save.run();
    setOverlays((current) => ({ ...current, confirmDelete: false }));
  };

  return (
    <>
      <div
        className={\`ub-stack \${styles['ub-n-root']}\`}
        data-direction="vertical"
        data-gap="4"
        data-align="stretch"
        data-justify="start"
      >
        <h1 className="ub-heading" data-level="1">{\`Seen \${text(state.count)} times\`}</h1>
        <input
          className="ub-input"
          type="text"
          placeholder="Search people"
          data-disabled={truthy(state.busy) ? '' : undefined}
          disabled={truthy(state.busy)}
          onChange={onSearchChange}
        />
        <button
          className="ub-button"
          type="button"
          data-variant={pick(state.busy ? 'secondary' : 'default', ['default', 'secondary', 'outline', 'ghost', 'destructive', 'link'], 'default')}
          data-size="lg"
          onClick={onCountUpClick}
        >
          Count up
        </button>
        <button
          className="ub-button"
          type="button"
          data-variant="destructive"
          data-size="default"
          onClick={onDeleteClick}
        >
          Delete everything
        </button>
        <Overlay
          className="ub-modal"
          data-size="md"
          data-dim=""
          data-dismissable=""
          open={overlays.confirmDelete}
          onClose={() => setOverlays((current) => ({ ...current, confirmDelete: false }))}
        >
          <div className="ub-modal-backdrop" aria-hidden="true" data-close="" />
          <div className="ub-modal-panel" role="dialog" aria-modal="true">
            <div className="ub-modal-header">
              <div className="ub-modal-heading">
                <h2 className="ub-modal-title">Delete everything?</h2>
                <p className="ub-modal-description">This cannot be undone.</p>
              </div>
              <button className="ub-modal-close" type="button" aria-label="Close" data-close="">
                ×
              </button>
            </div>
            <div className="ub-modal-body">
              <button
                className="ub-button"
                type="button"
                data-variant="destructive"
                data-size="default"
                onClick={onConfirmClick}
              >
                Yes, delete
              </button>
            </div>
          </div>
        </Overlay>
        {truthy(!queries.people.data) && (
          <p className="ub-text" data-size="base" data-tone="muted">No people yet.</p>
        )}
        {list(queries.people.data).map((item, index) => {
          const onOpenClick = () => {
            goTo(\`/people/\${text(item.id)}\`);
          };

          return (
            <div key={index} className="ub-card">
              <p className="ub-text" data-size="base" data-tone="default">
                {text(item.name, 'Text')}
              </p>
              <button
                className="ub-button"
                type="button"
                data-variant="outline"
                data-size="default"
                onClick={onOpenClick}
              >
                Open
              </button>
            </div>
          );
        })}
        <table className="ub-table">
          <thead className="ub-table-head">
            <tr className="ub-table-row">
              <th className="ub-table-grip-cell" scope="col" />
              <th className="ub-table-header" scope="col">Name</th>
              <th className="ub-table-header" scope="col">Role</th>
            </tr>
          </thead>
          <SortableRows>
            {list(queries.people.data).length === 0 && (
              <tr className="ub-table-row">
                <td className="ub-table-empty" colSpan={3}>Nobody matched that search.</td>
              </tr>
            )}
            {list(queries.people.data).map((row, index) => (
              <tr key={index} className="ub-table-row">
                <td className="ub-table-grip-cell">
                  <button
                    type="button"
                    className="ub-table-grip"
                    data-grip=""
                    aria-label="Reorder row"
                  />
                </td>
                <td className="ub-table-cell">{cell(row, 'name')}</td>
                <td className="ub-table-cell">{cell(row, 'role')}</td>
              </tr>
            ))}
          </SortableRows>
        </table>
        <select className="ub-select" defaultValue="" data-placeholder="">
          <option value="" disabled hidden>Assign to</option>
          {options(queries.people.data, 'name', 'role').map((option) => (
            <option key={option.value} value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
      <Toasts toasts={toasts} />
    </>
  );
}
"
`;
